# HuggingFace Token (Optional, for model access if required)
# Get yours at: https://huggingface.co/settings/tokens
HF_TOKEN=your_huggingface_token_here

# PyTorch configuration for Mac (useful for M1/M2/M3 chips)
# Set to 1 to allow CPU fallback for operations not yet supported on Metal
PYTORCH_ENABLE_MPS_FALLBACK=1

# Application Settings
OUTPUT_DIR=outputs
LOG_LEVEL=INFO
